# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:replace-me
# Чат(ы) менеджеров: id или @username, несколько — через запятую
TELEGRAM_CHAT_ID=-1001234567890
# Базовый URL FastAPI сайта (см. ../website/api)
API_BASE_URL=http://localhost:8000
# Тот же админ-токен, что в website/api/.env
ADMIN_API_TOKEN=change-me
# Период опроса и размер страницы
POLL_INTERVAL_SECONDS=5
PAGE_SIZE=50
# Файл локального состояния доставки (последний отправленный id, ретраи)
STATE_DB_URL=sqlite+aiosqlite:///./data/bot_state.db
# Сколько раз повторять отправку и с какой задержкой, секунды
MAX_SEND_ATTEMPTS=5
RETRY_BACKOFF_SECONDS=10
# Картинка-обложка для сообщения о заявке (URL или локальный файл)
LEAD_CARD_IMAGE=app/static/lead-card.jpg