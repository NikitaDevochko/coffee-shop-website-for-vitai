ENV=local
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000
# SQLite рядом с кодом; в проде — абсолютный путь постоянного диска
DATABASE_URL=sqlite+aiosqlite:///./data/leads.db
# CORS: домен фронта (Vercel) и localhost
CORS_ORIGINS=["http://localhost:3000"]
# Окно дедупликации одинаковых заявок, минуты
LEAD_DEDUP_WINDOW_MINUTES=10
# Админ-токен для GET /api/leads (его же использует телеграм-бот для чтения заявок)
ADMIN_API_TOKEN=change-me
# За обратным прокси берём X-Forwarded-For
TRUST_PROXY_HEADERS=true