# В этом окружении pnpm 11 ставит пакеты в изолированный node_modules, и транзитивные
# зависимости next (например styled-jsx) не оказываются в корне — `next dev` падает с
# "Cannot find module 'styled-jsx/package.json'". Плоская раскладка это чинит.
node-linker=hoisted

# esbuild собирает бинарник в postinstall. Без разрешения pnpm помечает установку
# проваленной (ERR_PNPM_IGNORED_BUILDS), и `pnpm exec` перестаёт работать.
allowBuilds.esbuild=true
